# Copy to .env.local for local dev (never commit secrets).

# Supabase (Vercel integration usually provides these names)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (domain verified for hopesews.com)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=hello@hopesews.com
CONTACT_NOTIFY_EMAIL=hello@hopesews.com,team@hopesews.com
CONTACT_SUPPORT_EMAIL=hello@hopesews.com

# Public site URL (used for absolute links in transactional email)
SITE_URL=https://hopesews.com
# Optional override for logo in email header
# SITE_LOGO_URL=https://hopesews.com/img/logo-wip7.webp
