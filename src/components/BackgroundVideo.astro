---
interface Props {
	src: string;
	poster?: string;
	class?: string;
	preload?: "auto" | "metadata" | "none";
	fetchPriority?: "high" | "low" | "auto";
}

const {
	src,
	poster = src.replace(/\.mp4$/i, ".poster.webp"),
	class: className = "",
	preload = "auto",
	fetchPriority,
} = Astro.props;
---

<div
	data-background-video-host
	class:list={["fixed inset-0 z-0 h-full w-full bg-cover bg-center bg-no-repeat", className]}
	style={`background-image: url('${poster}')`}
	aria-hidden="true"
>
	<video
		data-background-video
		class="absolute inset-0 h-full w-full object-cover"
		autoplay
		muted
		loop
		playsinline
		webkit-playsinline
		preload={preload}
		poster={poster}
		disablePictureInPicture
		controlslist="nodownload nofullscreen noremoteplayback"
		fetchpriority={fetchPriority}
	>
		<source src={src} type="video/mp4" />
	</video>
</div>

<script>
	import "../scripts/init-background-videos.ts";
</script>
